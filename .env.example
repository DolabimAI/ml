# Bu dosyayı .env olarak kopyalayın. Gerçek anahtarları depoya YÜKLEMEYİN (.env Git tarafından yok sayılır).
# Gerçek değerleri Zehra ekibe ayrıca verir.
ML_HOST=127.0.0.1
ML_PORT=8000

# Görüntü modülü (D2) için: Python yalnızca görsel deposuna yazar, veritabanına bağlanmaz.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=gorseller
